    %fc2_IF_acc = snn_op.linear %fc1_IF {bias = "nir://block_05_until_silent_t32_integer_lcc.nir#/node/nodes/fc2_IF/metadata/bias", in_features = 512 : i64, out_features = 128 : i64, spike_encoding = "ternary", time_dim = 0 : i64, weight = "nir://block_05_until_silent_t32_integer_lcc.nir#/node/nodes/fc2_IF/metadata/weight"} : (tensor<32x1x65x512x!snn.spike<ternary>>) -> tensor<32x1x65x128xi32>
    %fc2_IF = snn_op.st_bif %fc2_IF_acc {neuron_model = "st_bif", threshold = 10911.0 : f64, time_dim = 0 : i64, tr_max = 7.0 : f64, tr_min = -7.0 : f64} : (tensor<32x1x65x128xi32>) -> tensor<32x1x65x128x!snn.spike<ternary>>
    %residual_norm1_IF_acc = snn_op.rescale %fc2_IF {scale = 1.0 : f64, time_dim = 0 : i64} : (tensor<32x1x65x128x!snn.spike<ternary>>) -> tensor<32x1x128xi32>
    %residual_norm1_IF = snn_op.st_bif %residual_norm1_IF_acc {neuron_model = "st_bif", threshold = 20413.0 : f64, time_dim = 0 : i64, tr_max = 7.0 : f64, tr_min = -7.0 : f64} : (tensor<32x1x128xi32>) -> tensor<32x1x128x!snn.spike<ternary>>
